{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamGuard",
  "version": "0.1.0",
  "identifier": "com.streamguard.desktop",
  "mainBinaryName": "streamguard-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StreamGuard",
        "width": 760,
        "height": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
