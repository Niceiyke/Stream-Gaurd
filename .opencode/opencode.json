{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "cargo check*": "allow",
      "cargo check --all-targets*": "allow",
      "cargo test*": "allow",
      "cargo clippy*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git grep*": "allow",
      "cargo fmt*": "deny",
      "cargo fmt --check*": "allow"
    }
  }
}